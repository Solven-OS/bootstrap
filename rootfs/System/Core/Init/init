#!/System/Commands/sh
# SPDX-License-Identifier: GPL-2.0-or-later

export HOME=/Users/root
export PATH=/Users/root/Commands:/System/Commands
export SHELL=/System/Commands/sh
export ENV=/System/Core/Shell/interactive.sh
export TERM=xterm-256color
export TERMINFO=/Programs/CLI/Nano/Resources/terminfo
export TMPDIR=/Runtime/Temp
export LANG=C
export HISTFILE=/Users/root/State/Shell/history
export HISTSIZE=256
export HISTFILESIZE=512

umask 022

[ -e /dev/null ] || mount -t devtmpfs devtmpfs /dev 2>/dev/null || :
[ -r /proc/mounts ] || mount -t proc proc /proc 2>/dev/null || :
[ -d /sys/kernel ] || mount -t sysfs sysfs /sys 2>/dev/null || :

if ! mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /Runtime; then
    printf 'Warning: /Runtime is not ephemeral; tmpfs mount failed.\n'
fi

mkdir -p \
    /Runtime/System/Network \
    /Runtime/Programs \
    /Runtime/Users \
    /Runtime/Temp \
    /Users/root/State/Shell
chmod 1777 /Runtime/Temp
: > /Runtime/System/Network/resolv.conf
touch "$HISTFILE"

ip link set lo up || printf 'Warning: failed to bring up loopback.\n'

printf 'Configuring network...\n'
if ip link set eth0 up && udhcpc -i eth0 -q -n -t 5 -T 2; then
    printf '\nNetwork addresses:\n'
    ip addr
    printf '\nDefault route:\n'
    ip route show default
    printf '\nDNS servers:\n'
    if [ -s /Runtime/System/Network/resolv.conf ]; then
        cat /Runtime/System/Network/resolv.conf
    else
        printf 'No DNS servers received\n'
    fi
else
    printf 'Network configuration failed; continuing without networking.\n'
fi

printf '\nWelcome to Solven\n\n'
cd /
exec /System/Commands/setsid /System/Commands/cttyhack /System/Commands/sh -i
