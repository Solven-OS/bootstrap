#!/System/Commands/sh
# SPDX-License-Identifier: GPL-2.0-or-later

resolv_conf=/Runtime/System/Network/resolv.conf

case "$1" in
    deconfig)
        ip addr flush dev "$interface"
        ip link set dev "$interface" up
        ;;
    bound|renew)
        address="$ip"
        [ -n "$subnet" ] && address="$address/$subnet"

        ip addr flush dev "$interface"
        ip addr add "$address" dev "$interface"
        ip link set dev "$interface" up

        ip route del default 2>/dev/null || :
        for gateway in $router; do
            ip route add default via "$gateway" dev "$interface"
            break
        done

        : > "$resolv_conf"
        [ -n "$domain" ] && printf 'search %s\n' "$domain" >> "$resolv_conf"
        for server in $dns; do
            printf 'nameserver %s\n' "$server" >> "$resolv_conf"
        done
        ;;
esac

exit 0
