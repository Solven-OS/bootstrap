# Minimal BusyBox configuration fragment for the bootstrap initramfs.
CONFIG_BUSYBOX=y
CONFIG_STATIC=y
CONFIG_LONG_OPTS=y
CONFIG_FEATURE_PREFER_APPLETS=y
CONFIG_SH_IS_ASH=y
CONFIG_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_FEATURE_SH_EXTRA_QUIET=y
CONFIG_MKDIR=y
CONFIG_SLEEP=y
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_SWITCH_ROOT=y
CONFIG_BLKID=y
CONFIG_FEATURE_BLKID_TYPE=y
CONFIG_FEATURE_VOLUMEID_EXT=y
